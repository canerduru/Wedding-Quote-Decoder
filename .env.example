# Two ways to run the app:
#
# 1) Public (default): leave APP_PASSWORD empty. Anyone can open the site and
#    must paste their OWN Gemini API key on the page. GEMINI_API_KEY below is
#    ignored in this mode, so your key is never spent by visitors.
#
# 2) Private: set APP_PASSWORD. The browser asks for a password (any username)
#    and, if GEMINI_API_KEY is also set, the server uses that key for you.

# GEMINI_API_KEY: only used in private mode (APP_PASSWORD is set).
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: leave empty for public mode.
APP_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
